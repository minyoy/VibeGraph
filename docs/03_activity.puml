@startuml
title VibeGraph Activity Diagram

skinparam shadowing false
skinparam activity {
BackgroundColor #F8FAFC
BorderColor #334155
FontColor #0F172A
}

start

:User signs in with Apple Music;
if (Sign-in successful?) then (Yes)
:Load user's playlists;
:Show playlist list;
else (No)
:Show sign-in error message;
stop
endif

:User selects playlists to analyze;
if (At least one playlist selected?) then (Yes)
:Start graph synchronization;
else (No)
:Ask user to select a playlist;
stop
endif

:Fetch tracks from selected playlists;
if (Playlist data loaded?) then (Yes)
:Save music data into Neo4j Graph DB;
:Show synchronization result;
else (No)
:Show Apple Music API error;
stop
endif

:User requests taste analysis;
if (Graph data available?) then (Yes)
:Analyze frequently listened artists and genres;
:Show taste profile;
else (No)
:Show graph data error;
stop
endif

:User requests graph-based recommendation;
if (Recommendation candidates found?) then (Yes)
:Show recommended tracks and graph paths;
else (No)
:Suggest syncing more playlists;
stop
endif

:Generate AI-based recommendation explanation;
if (Explanation generated?) then (Yes)
:Show playlist name and track-level reasons;
else (No)
:Show AI explanation error;
stop
endif

:User creates a recommendation playlist;
if (Playlist can be created?) then (Yes)
:Create a new playlist in Apple Music;
else (No)
:Show playlist creation error;
stop
endif

if (Creation successful?) then (Yes)
:Show created playlist information;
else (No)
:Show Apple Music creation error;
endif

stop
@enduml
